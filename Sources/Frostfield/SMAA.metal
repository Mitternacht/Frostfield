#include <metal_stdlib>
using namespace metal;

// Matches SMAA.ShaderOptions: 48 bytes.
struct SMAAOptions {
    float4 metrics;           // SMAA_RT_METRICS: (1 / width, 1 / height, width, height)
    float threshold;          // SMAA_THRESHOLD
    float maxSearchSteps;     // SMAA_MAX_SEARCH_STEPS
    float maxSearchStepsDiag; // SMAA_MAX_SEARCH_STEPS_DIAG
    float cornerRounding;     // SMAA_CORNER_ROUNDING_NORM
    uint flags;               // 1: diagonal detection, 2: corner detection
    float padding0;
    float padding1;
    float padding2;
};

constant constexpr uint smaaDiagonals = 1;
constant constexpr uint smaaCorners = 2;
constant constexpr float smaaLocalContrastAdaptation = 2.0f;
constant constexpr float smaaAreaMaxDistance = 16.0f;
constant constexpr float smaaAreaMaxDistanceDiag = 20.0f;
// The generated area table holds only subsample offset 0 (SMAA 1x): 160 × 80.
constant constexpr float2 smaaAreaPixelSize = float2(1.0f / 160.0f, 1.0f / 80.0f);
constant constexpr float2 smaaSearchSize = float2(66.0f, 33.0f);
constant constexpr float2 smaaSearchPackedSize = float2(64.0f, 16.0f);

constexpr sampler smaaLinear(coord::normalized, address::clamp_to_edge, filter::linear);
constexpr sampler smaaPoint(coord::normalized, address::clamp_to_edge, filter::nearest);

vertex float4 frostfield_smaa_vertex(uint vertexID [[vertex_id]]) {
    const float2 positions[] = {float2(-1, -1), float2(3, -1), float2(-1, 3)};
    return float4(positions[vertexID], 0, 1);
}

// MARK: - Edge detection (first pass)

// SMAA's luma edge detection expects gamma-encoded color; the source is linear,
// so each channel is sRGB-encoded first. Values above SDR white continue on the
// same curve, as in the extended sRGB transfer function of Core Graphics'
// extended-range sRGB color spaces, so edges between EDR highlights are found
// with the same thresholds instead of all sharing the luma of white.
static inline float smaaLuma(float3 linear) {
    float3 c = max(linear, float3(0.0f));
    float3 encoded = select(1.055f * pow(c, float3(1.0f / 2.4f)) - 0.055f, 12.92f * c, c <= 0.0031308f);
    return dot(encoded, float3(0.2126f, 0.7152f, 0.0722f));
}

fragment float2 frostfield_smaa_edges_fragment(
    float4 position [[position]],
    texture2d<float> colorTex [[texture(0)]],
    constant SMAAOptions& o [[buffer(0)]]
) {
    float2 texcoord = position.xy * o.metrics.xy;
    float4 offset0 = o.metrics.xyxy * float4(-1.0f, 0.0f, 0.0f, -1.0f) + texcoord.xyxy;
    float4 offset1 = o.metrics.xyxy * float4(1.0f, 0.0f, 0.0f, 1.0f) + texcoord.xyxy;
    float4 offset2 = o.metrics.xyxy * float4(-2.0f, 0.0f, 0.0f, -2.0f) + texcoord.xyxy;
    float2 threshold = float2(o.threshold);

    float L = smaaLuma(colorTex.sample(smaaPoint, texcoord, level(0)).rgb);
    float Lleft = smaaLuma(colorTex.sample(smaaPoint, offset0.xy, level(0)).rgb);
    float Ltop = smaaLuma(colorTex.sample(smaaPoint, offset0.zw, level(0)).rgb);

    float4 delta;
    delta.xy = abs(L - float2(Lleft, Ltop));
    float2 edges = step(threshold, delta.xy);
    if (dot(edges, float2(1.0f)) == 0.0f) { discard_fragment(); }

    float Lright = smaaLuma(colorTex.sample(smaaPoint, offset1.xy, level(0)).rgb);
    float Lbottom = smaaLuma(colorTex.sample(smaaPoint, offset1.zw, level(0)).rgb);
    delta.zw = abs(L - float2(Lright, Lbottom));
    float2 maxDelta = max(delta.xy, delta.zw);

    float Lleftleft = smaaLuma(colorTex.sample(smaaPoint, offset2.xy, level(0)).rgb);
    float Ltoptop = smaaLuma(colorTex.sample(smaaPoint, offset2.zw, level(0)).rgb);
    delta.zw = abs(float2(Lleft, Ltop) - float2(Lleftleft, Ltoptop));

    maxDelta = max(maxDelta.xy, delta.zw);
    float finalDelta = max(maxDelta.x, maxDelta.y);

    // Local contrast adaptation.
    edges.xy *= step(finalDelta, smaaLocalContrastAdaptation * delta.xy);
    return edges;
}

// MARK: - Diagonal search

static inline float2 smaaDecodeDiagBilinearAccess(float2 e) {
    e.r = e.r * abs(5.0f * e.r - 5.0f * 0.75f);
    return rint(e);
}

static inline float4 smaaDecodeDiagBilinearAccess(float4 e) {
    e.rb = e.rb * abs(5.0f * e.rb - 5.0f * 0.75f);
    return rint(e);
}

static float2 smaaSearchDiag1(
    texture2d<float> edgesTex, float2 texcoord, float2 dir, thread float2& e, constant SMAAOptions& o
) {
    float4 coord = float4(texcoord, -1.0f, 1.0f);
    float3 t = float3(o.metrics.xy, 1.0f);
    while (coord.z < o.maxSearchStepsDiag - 1.0f && coord.w > 0.9f) {
        coord.xyz = t * float3(dir, 1.0f) + coord.xyz;
        e = edgesTex.sample(smaaLinear, coord.xy, level(0)).rg;
        coord.w = dot(e, float2(0.5f));
    }
    return coord.zw;
}

static float2 smaaSearchDiag2(
    texture2d<float> edgesTex, float2 texcoord, float2 dir, thread float2& e, constant SMAAOptions& o
) {
    float4 coord = float4(texcoord, -1.0f, 1.0f);
    coord.x += 0.25f * o.metrics.x;
    float3 t = float3(o.metrics.xy, 1.0f);
    while (coord.z < o.maxSearchStepsDiag - 1.0f && coord.w > 0.9f) {
        coord.xyz = t * float3(dir, 1.0f) + coord.xyz;
        // Fetch both edges at once using bilinear filtering.
        e = edgesTex.sample(smaaLinear, coord.xy, level(0)).rg;
        e = smaaDecodeDiagBilinearAccess(e);
        coord.w = dot(e, float2(0.5f));
    }
    return coord.zw;
}

static inline float2 smaaAreaDiag(texture2d<float> areaTex, float2 dist, float2 e) {
    float2 texcoord = float2(smaaAreaMaxDistanceDiag) * e + dist;
    texcoord = smaaAreaPixelSize * texcoord + 0.5f * smaaAreaPixelSize;
    // Diagonal areas are in the right half of the table.
    texcoord.x += 0.5f;
    return areaTex.sample(smaaLinear, texcoord, level(0)).rg;
}

static float2 smaaCalculateDiagWeights(
    texture2d<float> edgesTex, texture2d<float> areaTex, float2 texcoord, float2 e, constant SMAAOptions& o
) {
    float2 weights = float2(0.0f);
    float4 d;
    float2 end;
    if (e.r > 0.0f) {
        d.xz = smaaSearchDiag1(edgesTex, texcoord, float2(-1.0f, 1.0f), end, o);
        d.x += float(end.y > 0.9f);
    } else {
        d.xz = float2(0.0f);
    }
    d.yw = smaaSearchDiag1(edgesTex, texcoord, float2(1.0f, -1.0f), end, o);

    if (d.x + d.y > 2.0f) {
        // Fetch the crossing edges.
        float4 coords = float4(-d.x + 0.25f, d.x, d.y, -d.y - 0.25f) * o.metrics.xyxy + texcoord.xyxy;
        float4 c;
        c.xy = edgesTex.sample(smaaLinear, coords.xy, level(0), int2(-1, 0)).rg;
        c.zw = edgesTex.sample(smaaLinear, coords.zw, level(0), int2(1, 0)).rg;
        float4 decoded = smaaDecodeDiagBilinearAccess(c);
        c = float4(decoded.y, decoded.x, decoded.w, decoded.z);

        // Merge crossing edges at each side into a single value.
        float2 cc = float2(2.0f) * c.xz + c.yw;
        // Remove the crossing edge if the end of the line was not found.
        cc = select(cc, float2(0.0f), d.zw >= 0.9f);
        weights += smaaAreaDiag(areaTex, d.xy, cc);
    }

    d.xz = smaaSearchDiag2(edgesTex, texcoord, float2(-1.0f, -1.0f), end, o);
    if (edgesTex.sample(smaaLinear, texcoord, level(0), int2(1, 0)).r > 0.0f) {
        d.yw = smaaSearchDiag2(edgesTex, texcoord, float2(1.0f, 1.0f), end, o);
        d.y += float(end.y > 0.9f);
    } else {
        d.yw = float2(0.0f);
    }

    if (d.x + d.y > 2.0f) {
        float4 coords = float4(-d.x, -d.x, d.y, d.y) * o.metrics.xyxy + texcoord.xyxy;
        float4 c;
        c.x = edgesTex.sample(smaaLinear, coords.xy, level(0), int2(-1, 0)).g;
        c.y = edgesTex.sample(smaaLinear, coords.xy, level(0), int2(0, -1)).r;
        c.zw = edgesTex.sample(smaaLinear, coords.zw, level(0), int2(1, 0)).gr;
        float2 cc = float2(2.0f) * c.xz + c.yw;
        cc = select(cc, float2(0.0f), d.zw >= 0.9f);
        weights += smaaAreaDiag(areaTex, d.xy, cc).gr;
    }
    return weights;
}

// MARK: - Horizontal and vertical search

static inline float smaaSearchLength(texture2d<float> searchTex, float2 e, float offset) {
    // The table is flipped vertically, with left and right cases taking half of it horizontally.
    float2 scale = smaaSearchSize * float2(0.5f, -1.0f);
    float2 bias = smaaSearchSize * float2(offset, 1.0f);
    // Scale and bias to access texel centers.
    scale += float2(-1.0f, 1.0f);
    bias += float2(0.5f, -0.5f);
    // The table is cropped to 64 × 16.
    scale *= 1.0f / smaaSearchPackedSize;
    bias *= 1.0f / smaaSearchPackedSize;
    return searchTex.sample(smaaPoint, scale * e + bias, level(0)).r;
}

static float smaaSearchXLeft(
    texture2d<float> edgesTex, texture2d<float> searchTex, float2 texcoord, float end, constant SMAAOptions& o
) {
    float2 e = float2(0.0f, 1.0f);
    while (texcoord.x > end && e.g > 0.8281f && e.r == 0.0f) {
        e = edgesTex.sample(smaaLinear, texcoord, level(0)).rg;
        texcoord = -float2(2.0f, 0.0f) * o.metrics.xy + texcoord;
    }
    float offset = -(255.0f / 127.0f) * smaaSearchLength(searchTex, e, 0.0f) + 3.25f;
    return o.metrics.x * offset + texcoord.x;
}

static float smaaSearchXRight(
    texture2d<float> edgesTex, texture2d<float> searchTex, float2 texcoord, float end, constant SMAAOptions& o
) {
    float2 e = float2(0.0f, 1.0f);
    while (texcoord.x < end && e.g > 0.8281f && e.r == 0.0f) {
        e = edgesTex.sample(smaaLinear, texcoord, level(0)).rg;
        texcoord = float2(2.0f, 0.0f) * o.metrics.xy + texcoord;
    }
    float offset = -(255.0f / 127.0f) * smaaSearchLength(searchTex, e, 0.5f) + 3.25f;
    return -o.metrics.x * offset + texcoord.x;
}

static float smaaSearchYUp(
    texture2d<float> edgesTex, texture2d<float> searchTex, float2 texcoord, float end, constant SMAAOptions& o
) {
    float2 e = float2(1.0f, 0.0f);
    while (texcoord.y > end && e.r > 0.8281f && e.g == 0.0f) {
        e = edgesTex.sample(smaaLinear, texcoord, level(0)).rg;
        texcoord = -float2(0.0f, 2.0f) * o.metrics.xy + texcoord;
    }
    float offset = -(255.0f / 127.0f) * smaaSearchLength(searchTex, e.gr, 0.0f) + 3.25f;
    return o.metrics.y * offset + texcoord.y;
}

static float smaaSearchYDown(
    texture2d<float> edgesTex, texture2d<float> searchTex, float2 texcoord, float end, constant SMAAOptions& o
) {
    float2 e = float2(1.0f, 0.0f);
    while (texcoord.y < end && e.r > 0.8281f && e.g == 0.0f) {
        e = edgesTex.sample(smaaLinear, texcoord, level(0)).rg;
        texcoord = float2(0.0f, 2.0f) * o.metrics.xy + texcoord;
    }
    float offset = -(255.0f / 127.0f) * smaaSearchLength(searchTex, e.gr, 0.5f) + 3.25f;
    return -o.metrics.y * offset + texcoord.y;
}

static inline float2 smaaArea(texture2d<float> areaTex, float2 dist, float e1, float e2) {
    // Rounding prevents precision errors of bilinear filtering.
    float2 texcoord = float2(smaaAreaMaxDistance) * rint(4.0f * float2(e1, e2)) + dist;
    texcoord = smaaAreaPixelSize * texcoord + 0.5f * smaaAreaPixelSize;
    return areaTex.sample(smaaLinear, texcoord, level(0)).rg;
}

// MARK: - Corner detection

static float2 smaaDetectHorizontalCornerPattern(
    texture2d<float> edgesTex, float2 weights, float4 texcoord, float2 d, constant SMAAOptions& o
) {
    if ((o.flags & smaaCorners) == 0) { return weights; }
    float2 leftRight = step(d.xy, d.yx);
    float2 rounding = (1.0f - o.cornerRounding) * leftRight;
    rounding /= leftRight.x + leftRight.y; // Reduce blending for pixels in the center of a line.
    float2 factor = float2(1.0f);
    factor.x -= rounding.x * edgesTex.sample(smaaLinear, texcoord.xy, level(0), int2(0, 1)).r;
    factor.x -= rounding.y * edgesTex.sample(smaaLinear, texcoord.zw, level(0), int2(1, 1)).r;
    factor.y -= rounding.x * edgesTex.sample(smaaLinear, texcoord.xy, level(0), int2(0, -2)).r;
    factor.y -= rounding.y * edgesTex.sample(smaaLinear, texcoord.zw, level(0), int2(1, -2)).r;
    return weights * saturate(factor);
}

static float2 smaaDetectVerticalCornerPattern(
    texture2d<float> edgesTex, float2 weights, float4 texcoord, float2 d, constant SMAAOptions& o
) {
    if ((o.flags & smaaCorners) == 0) { return weights; }
    float2 leftRight = step(d.xy, d.yx);
    float2 rounding = (1.0f - o.cornerRounding) * leftRight;
    rounding /= leftRight.x + leftRight.y;
    float2 factor = float2(1.0f);
    factor.x -= rounding.x * edgesTex.sample(smaaLinear, texcoord.xy, level(0), int2(1, 0)).g;
    factor.x -= rounding.y * edgesTex.sample(smaaLinear, texcoord.zw, level(0), int2(1, 1)).g;
    factor.y -= rounding.x * edgesTex.sample(smaaLinear, texcoord.xy, level(0), int2(-2, 0)).g;
    factor.y -= rounding.y * edgesTex.sample(smaaLinear, texcoord.zw, level(0), int2(-2, 1)).g;
    return weights * saturate(factor);
}

// MARK: - Blending weight calculation (second pass)

fragment float4 frostfield_smaa_weights_fragment(
    float4 position [[position]],
    texture2d<float> edgesTex [[texture(0)]],
    texture2d<float> areaTex [[texture(1)]],
    texture2d<float> searchTex [[texture(2)]],
    constant SMAAOptions& o [[buffer(0)]]
) {
    float2 texcoord = position.xy * o.metrics.xy;
    float2 pixcoord = texcoord * o.metrics.zw;
    // Offsets for the searches (see @PSEUDO_GATHER4 in SMAA.hlsl) and their ends.
    float4 offset0 = o.metrics.xyxy * float4(-0.25f, -0.125f, 1.25f, -0.125f) + texcoord.xyxy;
    float4 offset1 = o.metrics.xyxy * float4(-0.125f, -0.25f, -0.125f, 1.25f) + texcoord.xyxy;
    float4 offset2 = o.metrics.xxyy * (float4(-2.0f, 2.0f, -2.0f, 2.0f) * o.maxSearchSteps)
        + float4(offset0.xz, offset1.yw);

    float4 weights = float4(0.0f);
    float2 e = edgesTex.sample(smaaLinear, texcoord, level(0)).rg;

    if (e.g > 0.0f) { // Edge at north
        bool diagonal = false;
        if ((o.flags & smaaDiagonals) != 0) {
            // Diagonals have both north and west edges, so searching from one boundary is enough.
            weights.rg = smaaCalculateDiagWeights(edgesTex, areaTex, texcoord, e, o);
            // Diagonals take priority over horizontal and vertical processing.
            diagonal = weights.r != -weights.g;
        }
        if (!diagonal) {
            float2 d;
            float3 coords;
            coords.x = smaaSearchXLeft(edgesTex, searchTex, offset0.xy, offset2.x, o);
            coords.y = offset1.y; // texcoord.y - 0.25 pixel (@CROSSING_OFFSET)
            d.x = coords.x;
            // Fetch the left crossing edges, two at a time with bilinear filtering.
            float e1 = edgesTex.sample(smaaLinear, coords.xy, level(0)).r;
            coords.z = smaaSearchXRight(edgesTex, searchTex, offset0.zw, offset2.y, o);
            d.y = coords.z;
            // Distances in pixels.
            d = abs(rint(o.metrics.zz * d - pixcoord.xx));
            // The area table is compressed quadratically.
            float2 sqrtD = sqrt(d);
            float e2 = edgesTex.sample(smaaLinear, coords.zy, level(0), int2(1, 0)).r;
            weights.rg = smaaArea(areaTex, sqrtD, e1, e2);
            coords.y = texcoord.y;
            weights.rg = smaaDetectHorizontalCornerPattern(edgesTex, weights.rg, coords.xyzy, d, o);
        } else {
            e.r = 0.0f; // Skip vertical processing.
        }
    }

    if (e.r > 0.0f) { // Edge at west
        float2 d;
        float3 coords;
        coords.y = smaaSearchYUp(edgesTex, searchTex, offset1.xy, offset2.z, o);
        coords.x = offset0.x; // texcoord.x - 0.25 pixel
        d.x = coords.y;
        float e1 = edgesTex.sample(smaaLinear, coords.xy, level(0)).g;
        coords.z = smaaSearchYDown(edgesTex, searchTex, offset1.zw, offset2.w, o);
        d.y = coords.z;
        d = abs(rint(o.metrics.ww * d - pixcoord.yy));
        float2 sqrtD = sqrt(d);
        float e2 = edgesTex.sample(smaaLinear, coords.xz, level(0), int2(0, 1)).g;
        weights.ba = smaaArea(areaTex, sqrtD, e1, e2);
        coords.x = texcoord.x;
        weights.ba = smaaDetectVerticalCornerPattern(edgesTex, weights.ba, coords.xyxz, d, o);
    }
    return weights;
}

// MARK: - Neighborhood blending (third pass)

fragment float4 frostfield_smaa_blend_fragment(
    float4 position [[position]],
    texture2d<float> colorTex [[texture(0)]],
    texture2d<float> blendTex [[texture(1)]],
    constant SMAAOptions& o [[buffer(0)]]
) {
    float2 texcoord = position.xy * o.metrics.xy;
    float4 offset = o.metrics.xyxy * float4(1.0f, 0.0f, 0.0f, 1.0f) + texcoord.xyxy;

    // The blending weights for the current pixel.
    float4 a;
    a.x = blendTex.sample(smaaLinear, offset.xy, level(0)).a; // Right
    a.y = blendTex.sample(smaaLinear, offset.zw, level(0)).g; // Bottom
    float4 own = blendTex.sample(smaaLinear, texcoord, level(0));
    a.w = own.x; // Top
    a.z = own.z; // Left

    if (dot(a, float4(1.0f)) < 1e-5f) {
        return colorTex.read(uint2(position.xy));
    }
    bool h = max(a.x, a.z) > max(a.y, a.w); // max(horizontal) > max(vertical)
    float4 blendingOffset = h ? float4(a.x, 0.0f, a.z, 0.0f) : float4(0.0f, a.y, 0.0f, a.w);
    float2 blendingWeight = h ? a.xz : a.yw;
    blendingWeight /= dot(blendingWeight, float2(1.0f));
    float4 blendingCoord = blendingOffset * float4(o.metrics.xy, -o.metrics.xy) + texcoord.xyxy;
    // Bilinear filtering mixes the pixel with the chosen neighbor. Premultiplied
    // RGBA blends as one value.
    float4 color = blendingWeight.x * colorTex.sample(smaaLinear, blendingCoord.xy, level(0));
    color += blendingWeight.y * colorTex.sample(smaaLinear, blendingCoord.zw, level(0));
    return color;
}
